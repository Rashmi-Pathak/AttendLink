generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id              String   @id @default(cuid())
  professorName   String
  courseCode      String
  cohort          String   @default("General")
  createdAt       DateTime @default(now())
  isActive        Boolean  @default(true)
  expiresAt       DateTime?
  latitude        Float
  longitude       Float
  radius          Float    @default(50)
  durationMinutes Int      @default(15)
  attendees       AttendanceRecord[]
}

model AttendanceRecord {
  id                String   @id @default(cuid())
  sessionId         String
  session           Session  @relation(fields: [sessionId], references: [id])
  studentName       String
  rollNumber        String
  timestamp         DateTime @default(now())
  latitude          Float?
  longitude         Float?
  deviceFingerprint String?
  
  @@unique([sessionId, rollNumber])
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        String   // 'STUDENT' or 'PROFESSOR'
  rollNumber  String?
  cohort      String?
  createdAt   DateTime @default(now())
  courses     Course[]
}

model Course {
  id          String   @id @default(cuid())
  name        String
  cohort      String
  professorId String
  professor   User     @relation(fields: [professorId], references: [id])
  createdAt   DateTime @default(now())
}
